# ==============================================================================
# PDFinity Environment Variables Template
# ==============================================================================
# Copy this file to:
# - server/.env for backend configuration
# - client/.env for frontend configuration (or set in Vercel / hosting platform)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Atlas or local MongoDB connection URI
# For production, use MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pdfinity?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random string in production, min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Expiration time (e.g. 7d, 24h)
JWT_EXPIRE=7d

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
# In production, set to your Vercel domain:
CLIENT_URL=https://your-frontend.vercel.app

# Upload and Processing Limits (bytes)
MAX_FILE_SIZE_FREE=10485760
MAX_FILE_SIZE_PREMIUM=104857600
MAX_FILES_FREE=5
MAX_FILES_PREMIUM=50

# Temporary file time-to-live before scheduled cleanup (minutes)
TEMP_FILE_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# Frontend Configuration (client/.env or Vercel Environment Variables)
# ------------------------------------------------------------------------------
# In production on Vercel, set VITE_API_URL to your Render backend API URL:
VITE_API_URL=https://your-backend.onrender.com/api
