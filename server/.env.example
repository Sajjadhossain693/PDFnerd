# Backend Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pdfinity?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Allowed Frontend URL for CORS (no trailing slash, supports comma-separated)
CLIENT_URL=https://pdf-nerd.vercel.app

# File limits (bytes)
MAX_FILE_SIZE_FREE=10485760
MAX_FILE_SIZE_PREMIUM=104857600
MAX_FILES_FREE=5
MAX_FILES_PREMIUM=50

# Cleanup interval in minutes
TEMP_FILE_TTL_MINUTES=60
